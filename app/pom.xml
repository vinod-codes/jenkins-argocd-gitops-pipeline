<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot application for the Jenkins + SonarQube + ArgoCD GitOps
      pipeline. Fixes applied against the original reference pom.xml:
        - Spring Boot 2.2.4.RELEASE (end of life) -> 3.5.16, the final
          3.x open-source patch (3.4.x left open-source support on
          31 Dec 2025; 3.5.x on 30 Jun 2026). The move to the Spring
          Boot 4.x line is a generation change (Spring Framework 7,
          Jakarta EE 11, Jackson 3) and is tracked separately, not
          silently applied.
        - Java 11 -> 17
        - groupId and artifact renamed to com.vinodg / gitops-demo
        - spring-boot-devtools dropped: a dev-only dependency has no place
          in a container image
        - maven-compiler-plugin 3.8.0 -> 3.14.1 and maven-surefire-plugin
          3.0.0 -> 3.5.6, the versions Spring Boot 3.5.16 manages
        - sonar-maven-plugin pinned (the reference invoked sonar:sonar
          without declaring the plugin)
    -->
    <groupId>com.vinodg</groupId>
    <artifactId>gitops-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>gitops-demo</name>
    <description>Small Spring Boot web application used to demonstrate a Jenkins + SonarQube + ArgoCD GitOps pipeline.</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <sonar.projectKey>gitops-demo</sonar.projectKey>
        <sonar.host.url>http://localhost:9000</sonar.host.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>4.0.0.4121</version>
            </plugin>
        </plugins>
    </build>
</project>
